{
  "name": "angular-api-inspector",
  "version": "0.0.0",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "build:scripts": "node scripts/build-extension.mjs --skip-panel",
    "build:demo": "ng build demo-app && ng build demo-app --configuration zoneless",
    "demo": "node e2e/server.mjs",
    "typecheck": "tsc -p tsconfig.scripts.json && tsc -p extension/panel/tsconfig.app.json --noEmit && tsc -p demo-app/tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:demo && playwright test",
    "ng": "ng"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@hugeicons/angular": "^1.0.12",
    "@hugeicons/core-free-icons": "^4.3.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
