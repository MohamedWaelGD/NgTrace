{
  "manifest_version": 3,
  "name": "Angular API Inspector",
  "description": "Inspect Angular components and the API requests each one made.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "devtools_page": "devtools.html",
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://*.localhost/*",
    "https://*.localhost/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://*.localhost/*",
        "https://*.localhost/*"
      ],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://*.localhost/*",
        "https://*.localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
